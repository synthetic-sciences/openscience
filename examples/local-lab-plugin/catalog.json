{
  "id": "local-lab-example",
  "kind": "server-plugin",
  "summary": "Offline calibration source and arithmetic summary with a CSV result.",
  "entry": "./index.ts",
  "source": "https://github.com/synthetic-sciences/openscience/tree/main/examples/local-lab-plugin",
  "license": "Apache-2.0",
  "compatibility": {
    "publishedVersion": null,
    "developmentRequirements": ["structured-plugin-results", "plugin-connectors"]
  },
  "access": {
    "execution": "trusted-host-process",
    "credentials": [],
    "externalServices": [],
    "paidCompute": false
  },
  "outputs": ["text/csv"],
  "validation": {
    "command": "bun test",
    "fixture": "calibration-a: [1, 2, 3]",
    "expected": { "count": 3, "mean": 2 },
    "scientificScope": "Arithmetic on bundled illustrative data; no claim about experimental measurements."
  }
}
