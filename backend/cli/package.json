    "@ai-sdk/cerebras": "1.0.58",
    "@ai-sdk/cohere": "2.0.40",
    "@ai-sdk/deepinfra": "1.0.56",
    "@ai-sdk/deepseek": "1.0.55",
    "@ai-sdk/gateway": "2.0.144",
    "@ai-sdk/google": "2.0.95",
    "@ai-sdk/google-vertex": "3.0.171",
    "@ai-sdk/groq": "2.0.52",
    "@ai-sdk/mistral": "2.0.47",
    "@ai-sdk/openai": "2.0.123",
    "@ai-sdk/openai-compatible": "1.0.53",
