{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "2.0.69",
  "name": "@synsci/openscience",
  "type": "module",
  "description": "AI-powered CLI for ML research and development workflows",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "preinstall": "node ./script/preinstall.mjs || exit 0",
    "typecheck": "tsgo --noEmit",
    "test": "bun test --timeout 15000",
    "build": "bun run script/build.ts",
    "dev": "bun --no-env-file run --conditions=browser ./src/bootstrap.ts"
  },
  "bin": {
    "openscience": "./bin/openscience"
  },
  "files": [
    "bin",
    "src",
    "skills/"
  ],
  "exports": {
    "./*": "./src/*.ts"
  },
  "devDependencies": {
    "@synsci/script": "workspace:*",
    "@parcel/watcher-darwin-arm64": "2.5.1",
    "@parcel/watcher-darwin-x64": "2.5.1",
    "@parcel/watcher-linux-arm64-glibc": "2.5.1",
    "@parcel/watcher-linux-arm64-musl": "2.5.1",
    "@parcel/watcher-linux-x64-glibc": "2.5.1",
    "@parcel/watcher-linux-x64-musl": "2.5.1",
    "@parcel/watcher-win32-x64": "2.5.1",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/turndown": "5.0.5",
    "@types/yargs": "17.0.33",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:",
    "vscode-languageserver-types": "3.17.5"
  },
  "dependencies": {
