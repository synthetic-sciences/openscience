    "section": {
      "accno": "s-E-MTAB-1234",
      "type": "Study",
      "attributes": [
        {
          "name": "Title",
          "value": "Gene Expression Profile of AGS cell line cultured in 2D and in 3D conditions"
        },
        {
          "name": "Study type",
          "value": "transcription profiling by array",
          "valqual": [
            {
              "name": "Ontology",
              "value": "EFO"
            },
            {
              "name": "TermId",
              "value": "EFO_0002768"
            }
          ]
        },
        {
          "name": "Organism",
          "value": "Homo sapiens"
        },
        {
          "name": "Description",
          "value": "AGS cell line was cultured in standard T25 flasks (2D condition) and in T25 flasks precoated with 50 M-5L/cm2 of matrigel basement membrane (BD Biosciences) at a 1.5:1 proportion to RPMI serum-free medium (3D condition, overlay method). Cultures were maintained for 14 days with medium change every two days. Transcriptome alterations were then investigated."
        }
      ],
      "subsections": [
        [
          {
            "accno": "P-MTAB-27772",
            "type": "Protocols",
            "attributes": [
              {
                "name": "Name",
                "value": "P-MTAB-27772"
              },
              {
                "name": "Type",
                "value": "grow"
              },
              {
                "name": "Description",
                "value": "Cells were grown in a humidified incubator, at 37 C and 5% CO2 atmosphere. The culture medium used was RPMI-1640 supplemented with 10% fetal bovine serum, 100U/mL penicillin and 100M-5g/mL streptomycin. For 2D condition, AGS cells were cultured in standard T25 flasks. For 3D condition, AGS cells were cultured in T25 flasks precoated with 50M-5L/cm2 of matrigel basement membrane (BD Biosciences) at a 1.5:1 proportion to RPMI serum-free medium  (overlay method). Cultures were maintained for 14 days with medium change every two days."
              }
            ]
          },
          {
            "accno": "P-MTAB-27773",
            "type": "Protocols",
            "attributes": [
              {
                "name": "Name",
                "value": "P-MTAB-27773"
              },
              {
                "name": "Type",
                "value": "nucleic_acid_extraction"
              },
              {
                "name": "Description",
                "value": "Total RNA extraction was performed using TRI reagent (Sigma) and following the manufacturer`s guidlines."
              }
            ]
          },
          {
            "accno": "P-MTAB-27774",
            "type": "Protocols",
            "attributes": [
              {
                "name": "Name",
                "value": "P-MTAB-27774"
              },
              {
                "name": "Type",
                "value": "labeling"
              },
              {
                "name": "Description",
                "value": "Labeling was performed with the One-Color Microarray-Based Gene Expression Analysis Quick Amp Labeling kit (Agilent Technologies). 600ng of total RNA was used as input to generate Cyanine 3-labeled cRNA."
              }
            ]
          },
          {
            "accno": "P-MTAB-27775",
            "type": "Protocols",
            "attributes": [
              {
                "name": "Name",
                "value": "P-MTAB-27775"
              },
              {
                "name": "Type",
                "value": "hybridization"
              },
              {
                "name": "Description",
                "value": "Hybridization was carried out overnight for 17h at 65 C in a microarray hybridization oven Agilent G2545A (Agilent Technologies)."
              }
            ]
          },
          {
            "accno": "P-MTAB-27776",
            "type": "Protocols",
            "attributes": [
              {
                "name": "Name",
                "value": "P-MTAB-27776"
              },
              {
                "name": "Type",
                "value": "image_acquisition"
              },
              {
                "name": "Description",
                "value": "Images of the hybridizations were acquired using a G2505B Microarray Scanner (Agilent Technologies). The Feature Extraction software (Agilent Technologies) was used for spot identification, background subtraction and quantification of the fluorescent signal."
              }
            ]
          },
          {
            "accno": "P-MTAB-27777",
            "type": "Protocols",
            "attributes": [
              {
                "name": "Name",
                "value": "P-MTAB-27777"
              },
              {
                "name": "Type",
                "value": "bioassay_data_transformation"
              },
              {
                "name": "Description",
                "value": "Normalization was achieved by the median intensity over the entire array, using the median array as reference. Raw data was base 2 log-transformed and probe replicates were averaged."
              }
            ]
          }
        ],
