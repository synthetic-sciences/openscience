{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "framework": "vite",
  "buildCommand": "bun run build",
  "installCommand": "bun install --frozen-lockfile && cd ../.. && bun install --frozen-lockfile --ignore-scripts --filter '@synsci/docs'",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/benchmarks",
      "destination": "/benchmark",
      "permanent": true
    },
    {
      "source": "/blog/launch",
      "destination": "/benchmark",
      "permanent": true
    },
    {
      "source": "/legal/privacy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/legal/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/:page(download|ace|benchmark|privacy)/",
      "destination": "/:page",
      "permanent": true
    },
    {
      "source": "/docs/",
      "destination": "/docs",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/docs/:path*",
      "destination": "/docs/404.html"
    }
  ]
}
