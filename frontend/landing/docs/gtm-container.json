            "value": "<script>\n(function () {\n  if ({{DLV - growth_analytics}} !== true) return;\n  var id = 'G-2BF4QBMLXN';\n  var eventName = {{DLV - growth_event}};\n  var location = {{DLV - growth_page_location}};\n  var ads = {{DLV - growth_advertising}} === true;\n  var parameters = {\n    send_to: id,\n    page_location: location,\n    page_path: {{DLV - growth_page_path}},\n    site: {{DLV - growth_site}}\n  };\n  var fields = {\n    platform: {{DLV - growth_platform}},\n    method: {{DLV - growth_method}},\n    placement: {{DLV - growth_placement}},\n    destination_site: {{DLV - growth_destination_site}}\n  };\n  Object.keys(fields).forEach(function (key) {\n    if (fields[key]) parameters[key] = fields[key];\n  });\n  var referrer = '';\n  if (document.referrer) {\n    try { referrer = new URL(document.referrer).origin; } catch (error) {}\n  }\n  parameters.page_referrer = referrer;\n  window.dataLayer = window.dataLayer || [];\n  window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };\n  if (!window.__synsciGoogleTagLoaded) {\n    window.__synsciGoogleTagLoaded = true;\n    window.gtag('js', new Date());\n    var script = document.createElement('script');\n    script.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;\n    script.async = true;\n    document.head.appendChild(script);\n  }\n  window.gtag('config', id, {\n    send_page_view: false,\n    allow_google_signals: ads,\n    allow_ad_personalization_signals: ads,\n    page_location: location,\n    page_referrer: referrer\n  });\n  window.gtag('event', eventName, parameters);\n})();\n</script>"
